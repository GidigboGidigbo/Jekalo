# --- Required credentials ---

# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/jekalo

# Secret used to sign JWTs (falls back to "jekalo-dev-secret").
JWT_SECRET=change-me

# Paystack API secret key (transaction/signature verification).
PAYSTACK_SECRET_KEY=sk_test-your-paystack-secret-key

# Google Places API key — used by GET /addresses/search.
GOOGLE_API_KEY=your-google-places-api-key

# --- Optional ---

# HTTP port (default 3000).
PORT=3000

# Override for the Paystack API base URL (default https://api.paystack.co).
# PAYSTACK_BASE_URL=https://api.paystack.co

# Booking holds (unpaid seats/dates) are released after this many minutes
# (whole number, 1-10).
HOLD_EXPIRY_MINUTES=5

# How often the sweeper runs, in whole minutes (1-15).
SWEEP_INTERVAL_MINUTES=1
